# Minimal Dockerfile for GoReleaser
# Uses pre-built binary (with whisper.cpp statically linked), no build stage needed

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -d /home/goclaw goclaw

WORKDIR /home/goclaw

# Copy pre-built binary from GoReleaser (includes whisper statically linked)
COPY goclaw /usr/local/bin/

# Copy bundled whisper model to user's expected location
RUN mkdir -p /home/goclaw/.goclaw/stt/whisper
COPY --chown=goclaw:goclaw whisper-model/ggml-tiny.en.bin /home/goclaw/.goclaw/stt/whisper/

# Copy entrypoint script for first-run setup
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER goclaw

EXPOSE 1337

ENTRYPOINT ["/entrypoint.sh"]
